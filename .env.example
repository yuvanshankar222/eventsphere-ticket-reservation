# Server & Environment Configuration
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Security & Authentication
JWT_SECRET=eventsphere_super_secure_jwt_secret_change_in_prod_32chars_min
COOKIE_SECRET=eventsphere_cookie_secret_change_in_prod_32chars_min

# PostgreSQL Database Configuration
# In AI Studio/local dev without standalone Postgres, the system auto-initializes embedded PostgreSQL via @electric-sql/pglite.
# When running standalone PostgreSQL (e.g. via Docker Compose or cloud RDS):
DATABASE_URL=postgresql://eventsphere_user:eventsphere_pass@localhost:5432/eventsphere_db?schema=public

# Redis Configuration (Optional in dev, required in high-throughput production)
# When REDIS_URL is unavailable, the application gracefully activates in-memory caching and resilient cleanup.
REDIS_URL=redis://localhost:6379

# Mock Payment Gateway Settings
MOCK_PAYMENT_DEFAULT_STATUS=SUCCEEDED
MOCK_PAYMENT_LATENCY_MS=1200
MOCK_WEBHOOK_SECRET=eventsphere_mock_payment_gateway_hmac_secret_2026
